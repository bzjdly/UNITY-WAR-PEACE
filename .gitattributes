# Normalize text files across Windows, macOS, and Linux.
* text=auto

*.asmdef text eol=lf
*.asmref text eol=lf
*.asset text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.meta text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Unity YAML assets use SmartMerge when the merge driver is configured locally.
*.anim merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.mat merge=unityyamlmerge eol=lf
*.meta merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.preset merge=unityyamlmerge eol=lf
*.unity merge=unityyamlmerge eol=lf

# Binary art, audio, video, model, font, archive, and plugin assets.
